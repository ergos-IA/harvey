# Imagen para Railway (u otro PaaS con un volumen persistente).
# A diferencia del Dockerfile original, arranca el dashboard en $PORT
# (modo hosted: HTTPS del proveedor + HARVEY_DASHBOARD_TOKEN) y el bucle
# de Harvey a la vez, y guarda todo lo que Harvey escribe en el volumen /data.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/* /root/.cache

RUN useradd --create-home --uid 1000 harvey \
    && chown -R harvey:harvey /app /ms-playwright

COPY --chown=harvey:harvey harvey/ harvey/
COPY --chown=harvey:harvey prompts/ prompts/
COPY --chown=harvey:harvey skills/ skills/
COPY --chown=harvey:harvey harvey.yaml .
COPY --chmod=755 deploy/railway/entrypoint.sh /usr/local/bin/harvey-entrypoint
COPY --chmod=755 deploy/railway/harvey-cli.sh /usr/local/bin/harvey

# Claude Code CLI, instalado como el usuario de ejecución (~/.local/bin).
USER harvey
ENV HOME=/home/harvey PATH="/home/harvey/.local/bin:${PATH}"
RUN installer="$(mktemp)" \
    && curl -fsSL https://claude.ai/install.sh -o "$installer" \
    && bash "$installer" \
    && rm "$installer" \
    && python -c "from harvey.claude_runtime import check_cli; print(check_cli())"

# El entrypoint arranca como root solo para preparar el volumen
# (Railway lo monta como root) y luego baja a "harvey".
USER root
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/harvey-entrypoint"]
