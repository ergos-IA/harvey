# ============================================================
# Variables de entorno de Harvey
# Copia este archivo a .env y rellena tus valores:  cp .env.example .env
# No subas nunca .env al repositorio: está en .gitignore.
# Elige UN proveedor de email de los de abajo (pon channels.email.provider
# en harvey.yaml con el mismo valor): gmail (recomendado), smtp o instantly.
# Todo lo demás es opcional, pero se recomienda mucho un verificador de
# email (Reoon/ZeroBounce).
# ============================================================

# ------------------------------------------------------------
# PROVEEDOR DE EMAIL — cómo envía Harvey y lee las respuestas. Elige uno.
#
# Opción A: Gmail / Google Workspace  [RECOMENDADO para <50 en frío/día]
#   Pon provider: gmail en harvey.yaml. Usa un buzón de un dominio
#   secundario DEDICADO (nunca el principal), con SPF/DKIM/DMARC configurados.
#   1. Google Cloud Console → proyecto nuevo → activa la API de Gmail
#   2. Credenciales → ID de cliente de OAuth → tipo "Aplicación de escritorio"
#   3. Pega abajo el client id/secret y ejecuta: harvey gmail auth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Opción B: Cualquier buzón SMTP + IMAP  [AgentMail, Fastmail, contraseña de aplicación de Workspace]
#   Pon provider: smtp en harvey.yaml. IMAP_* toma por defecto los valores de SMTP_*.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# Opción B2: Microsoft 365 / Outlook  [para un buzón en Exchange Online]
#   Pon provider: microsoft en harvey.yaml. Exchange Online ya no acepta
#   contraseñas por IMAP, así que aquí se inicia sesión con OAuth:
#   1. entra.microsoft.com → Registros de aplicaciones → Nuevo registro
#      ("solo este directorio organizativo"; plataforma del URI de redirección
#      "Cliente público/nativo", valor http://localhost:8766)
#   2. Pega abajo el ID de aplicación (cliente) y el ID de directorio (inquilino)
#   3. Ejecuta: harvey microsoft auth   (después: harvey microsoft test)
M365_CLIENT_ID=
M365_TENANT_ID=

# Opción C: Instantly — plataforma de email en frío  [heredado]
# Dónde conseguirla: https://app.instantly.ai → Settings → Integrations → API Keys
# El acceso a la API requiere el plan Growth de Instantly o superior.
INSTANTLY_API_KEY=

# ------------------------------------------------------------
# LinkedIn — prospección con automatización del navegador  [OPCIONAL]
# Son las credenciales de la cuenta de LinkedIn en la que Harvey iniciará
# sesión con Playwright. AVISO: la automatización incumple las Condiciones
# de Servicio de LinkedIn y puede provocar que la cuenta sea restringida o
# baneada. Usa una cuenta que puedas permitirte perder, mantén los límites
# de frecuencia por defecto, o déjalo en blanco para omitirlo: Harvey
# prospectará mediante búsqueda web y sitios web de empresas.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# ------------------------------------------------------------
# Cloudflare Browser Rendering — rastreo profundo de sitios web durante el entrenamiento  [OPCIONAL]
# Permite rastrear tu propio sitio con JS renderizado al ejecutar `harvey train`.
# Dónde conseguirlo:
#   Account ID: https://dash.cloudflare.com → barra lateral derecha de cualquier zona, o la URL
#   API Token:  https://dash.cloudflare.com/profile/api-tokens → Create Token
#               → concede el permiso "Browser Rendering: Edit"
# Coste: ~5 $/mes en el plan de pago de Workers (~12,000 páginas). El plan gratuito tiene límites.
# Sin esto, Harvey usa su rastreador HTTP integrado (sin renderizado de JS).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ------------------------------------------------------------
# Verificación de email — cómo confirma Harvey que la dirección de un
# prospecto existe de verdad antes de enviar. Harvey aprende el PATRÓN de
# email de cada empresa y luego verifica UN candidato (el sondeo SMTP directo
# ya no funciona contra Google Workspace / Microsoft 365). Basta con
# CUALQUIERA de estas claves; añade ambas para la mejor cobertura. Sin
# ninguna, las direcciones se marcan como "guess" y nunca se envían.

# Reoon — el mejor plan gratuito para verificar email en frío (600 comprobaciones/mes,
# se renuevan cada mes + 100 que no caducan). Buena detección de catch-all.
# Dónde conseguirla: https://reoon.com/email-verifier → regístrate → API
REOON_API_KEY=

# ZeroBounce — 100 gratis/mes. Su motor de 2026 es el fiable para dominios
# catch-all de Microsoft 365 / Google Workspace; Harvey envía esos
# dominios aquí específicamente. https://zerobounce.net → API
ZEROBOUNCE_API_KEY=

# Hunter.io — descubrimiento de emails + búsqueda de patrones  [OPCIONAL]
# Plan gratuito: 50 verificaciones + 25 búsquedas de dominio/mes. Su búsqueda
# de dominio es la forma más barata de conocer el patrón de email de una empresa
# (se usa primero, así Harvey verifica una dirección en vez de adivinar seis).
# Dónde conseguirla: https://hunter.io → regístrate → API → API Keys
HUNTER_API_KEY=
# Búsquedas de dominio al mes en todo Harvey. 25 equivale al plan gratuito
# de Hunter; pon aquí lo que incluya tu plan si pagas por Hunter.
HUNTER_MONTHLY_SEARCHES=25

# Precleared — comprobación de cumplimiento normativo del email en frío por destinatario  [OPCIONAL]
# Solo se usa cuando compliance.precleared.enabled es true en harvey.yaml.
# Sin clave: 10 comprobaciones al día. Con clave gratuita: 25 al día. Más allá, packs de pago.
# Dónde conseguirla: https://precleared.dev/get-key
PRECLEARED_API_KEY=

# TrulyInbox — servicio de warmup (recomendado)  [OPCIONAL]
# Permite que `harvey warmup` lea si tu buzón está realmente calentado.
# Lo más fácil: ejecuta `harvey trulyinbox connect`, que comprueba la clave y rellena esto por ti.
# Consigue TrulyInbox: https://trulyinbox.com/?via=harvey  (el acceso a la API empieza en Starter)
TRULYINBOX_API_KEY=
TRULYINBOX_WORKSPACE_ID=

# ------------------------------------------------------------
# DISCOVERY — dónde encuentra Harvey negocios.  [TODO OPCIONAL]
# La fuente por defecto (OpenStreetMap) no necesita cuenta alguna:
#     harvey discover
# Mira todas las opciones, con precios reales, con:
#     harvey discover --providers      (o la pestaña Discover del panel)
# ------------------------------------------------------------

# DataForSEO — los datos de negocios locales y SERP más baratos que hay.
# Dónde conseguirla: https://app.dataforseo.com/api-access
#   NOTA: la contraseña de la API se genera automáticamente allí. NO es la
#   contraseña de tu cuenta. 1 $ de crédito gratis al registrarte; depósito
#   mínimo de 50 $ para pasar a producción.
# Coste: 0,372 $ por cada 1.000 negocios; 0,006 $ por búsqueda orgánica de profundidad 30 y
# 0,002 $ por búsqueda en Maps (endpoints Live).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Ponlo con cualquier valor para dirigir todas las llamadas al sandbox gratuito
# de DataForSEO. Misma forma de respuesta, datos ficticios, sin cargos: la
# manera correcta de probarlo.
DATAFORSEO_SANDBOX=

# Serper.dev — API de Google Search, usada para discovery y para las búsquedas de Scout.
# Dónde conseguirla: https://serper.dev → regístrate → Dashboard → API Key
# Coste: 2,500 consultas gratis sin tarjeta, luego un pack prepago de 50 $ (los
# créditos caducan a los 6 meses). Sin ella, Harvey recurre al scraping de
# DuckDuckGo/Bing, que tiene límites de frecuencia muy estrictos.
SERPER_API_KEY=

# TinyFish — búsqueda web para discovery y Scout. No registra posición en los resultados.
# Dónde conseguirla: https://agent.tinyfish.ai/api-keys
# Coste: gratis, sin tarjeta. Límites: 30 búsquedas por minuto, 500 por hora.
TINYFISH_API_KEY=

# ------------------------------------------------------------
# Calendly — reserva automática de reuniones  [AÚN NO SE USA — hoja de ruta]
# CALENDLY_API_KEY=
